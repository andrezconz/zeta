# Copia este archivo a .env.local y completa los valores reales.
# Nunca compartas estos valores en un chat ni los subas a git — este
# archivo es solo una plantilla y .env.local ya está en .gitignore.

# turso.tech > tu base de datos > "Connect" (o `turso db show <db> --url`
# y `turso db tokens create <db>` con la CLI).
# TURSO_AUTH_TOKEN da acceso total a la base de datos: solo se usa en el
# servidor (src/lib/db/client.ts) y jamás debe llevar el prefijo NEXT_PUBLIC_.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
